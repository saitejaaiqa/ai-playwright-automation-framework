{
  "name": "ai-playwright-automation-framework",
  "version": "1.0.0",
  "description": "AI-powered Playwright test automation framework using TypeScript for UI automation, API validation, regression testing and automated reporting.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:report": "playwright show-report reports/html-report",
    "test:ui": "playwright test --ui",
    "test:allure": "playwright test --reporter=list,allure-playwright",
    "report:allure": "npx allure serve allure-results",
    "lint": "tsc --noEmit",
    "pretest": "npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saitejaaiqa/ai-playwright-automation-framework.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/saitejaaiqa/ai-playwright-automation-framework/issues"
  },
  "homepage": "https://github.com/saitejaaiqa/ai-playwright-automation-framework#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "allure-playwright": "^3.14.0",
    "typescript": "^5.7.3"
  }
}
